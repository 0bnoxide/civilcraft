{
  "format": "cadcraft-workspace",
  "version": 1,
  "id": "pro-cad1",
  "name": "PRO-cad1 Ribbon",
  "nameKey": "shell.ws.procad1",
  "hintKey": "shell.ws.procad1.hint",
  "description": "The ribbon workspace of the drafting, building and civil design programs, in the Pro skin: a dark title bar with quick access, ribbon tabs and panels, an options bar, Properties over the browser on the left, document tabs, a view control bar and a command line in the status bar. The same chrome, sizes and icon colour in every app.",
  "author": "CadCraft",
  "license": "Apache-2.0",
  "look": { "density": "compact", "outline": "none", "tabs": "underline", "skin": "pro" },
  "blocks": [
    {"block": "titlebar", "place": "top", "order": 0, "quick": ["open", "save", "undo", "redo"]},
    {"block": "ribbon", "place": "top", "order": 1, "file": ["open", "save"], "collapse": true, "tearOff": true},
    {"block": "options", "place": "top", "order": 2},
    {"block": "toolbar", "place": "none"},
    {"block": "palettes", "place": "left-panel", "upper": "properties", "lower": ["browser", "panel"]},
    {"block": "viewtabs", "place": "view-top", "order": 0, "mode": "open"},
    {"block": "viewbar", "place": "view-bottom", "order": 0, "slots": ["scale", "detail", "range", "fit", "layout"]},
    {"block": "statusbar", "place": "bottom", "order": 0, "command": true}
  ]
}
